# ── AI ───────────────────────────────────────────────────────────────
# Required for AI-assisted planning and document generation. Never commit this value.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_CONCURRENCY=3

# ── Agent security ───────────────────────────────────────────────────
AGENT_API_KEY=                      # set it to require header X-API-Key on every /snow/* call (UI asks for it)
AGENT_ALLOWED_ORIGINS=              # comma list; default = localhost dev ports. "*" only for local demos
# AGENT_PORT=8001
AGENT_HOST=127.0.0.1
# MCP_API_KEY=                    # protects the MCP server when set
MCP_HOST=127.0.0.1
MCP_PORT=8002
MCP_TRANSPORT=streamable-http
MCP_URL=http://127.0.0.1:8002/mcp   # endpoint used by the local MCP Chat bridge

# ── ServiceNow ───────────────────────────────────────────────────────
SNOW_INSTANCE_URL=                  # canonical instance URL; optional unless shared credentials are enabled
SNOW_VERIFY_TLS=true                # keep true. false only for a lab instance with a self-signed cert
# OAuth (use when the instance refuses Basic auth): System OAuth > Application Registry > "Create an OAuth API endpoint for external clients"
SNOW_CLIENT_ID=
SNOW_CLIENT_SECRET=
# ServiceNow username/password are NOT configured here: each user signs in on the connect screen and every
# call uses that user's own credentials. Leave this false unless you deliberately want a shared fallback account.
SNOW_ALLOW_ENV_CREDS=false
SNOW_USER=
SNOW_PASS=

# ── Flow Designer flows (Humanize Generic Flow Server = snow_sdk, runs on the same machine) ─
# Build App flows & subflows are built automatically by the Flow Server (v6/flow-server, ServiceNow SDK),
# which start_agent.bat starts on port 3000. Only when that fails for an item is it built in the Flow Designer
# browser (Playwright), with pauses on the Build App screen.
# FLOW_SERVER_URL=http://127.0.0.1:3000
# FLOW_ENGINE=auto                 # auto (Flow Server, browser fallback) | server | browser
# FLOW_BROWSER_HEADLESS=false      # true = hidden browser (no step pauses)
# FLOW_PAUSE_TIMEOUT=1800          # seconds a paused build waits for your answer
# FLOW_KB_THRESHOLD=0.45           # similarity needed to reuse a subflow from the subflow library

# ── Jira (optional, for /snow/jira/push) ─────────────────────────────
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
